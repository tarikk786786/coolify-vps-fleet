{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "fleet_name": "Tarik VPS Production Fleet",
  "owner": "tarikk786786",
  "default_ssh_user": "root",
  "default_ssh_port": 22,
  "servers": [
    {
      "name": "vps-control-plane",
      "ip": "192.0.2.10",
      "user": "root",
      "port": 22,
      "role": "control-plane",
      "provider": "oracle-cloud",
      "region": "ap-hyderabad-1",
      "tags": ["primary", "coolify-master", "web-gateway"]
    },
    {
      "name": "vps-worker-01",
      "ip": "192.0.2.11",
      "user": "root",
      "port": 22,
      "role": "worker",
      "provider": "hetzner",
      "region": "hel1",
      "tags": ["compute", "docker-worker"]
    },
    {
      "name": "vps-worker-02",
      "ip": "192.0.2.12",
      "user": "ubuntu",
      "port": 22,
      "role": "worker",
      "provider": "contabo",
      "region": "eu-central-1",
      "tags": ["backup", "database-replica"]
    }
  ]
}
